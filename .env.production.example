# Copy to .env.production on the server and fill in real values:
#     cp .env.production.example .env.production
#
# .env.production is gitignored and must never be committed — it holds the
# Intuit client secret and the session signing key.

# ---- Intuit app credentials (developer.intuit.com > your app > Keys) ----
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# sandbox | production
QBO_ENVIRONMENT=production

# Must match a Redirect URI registered on the Intuit app, character for
# character — including https:// and the exact path.
QBO_REDIRECT_URI=https://qbo-summary.mmcconvert.com/quickbooks-return

# Intuit API minor version.
QBO_MINOR_VERSION=75

# ---- Server -------------------------------------------------------------
# The browser origin. Now the same host as the API — the client is served by
# the app itself in production, so there is no separate :5173 origin.
CLIENT_ORIGIN=https://qbo-summary.mmcconvert.com

# Signs session cookies. Generate a fresh one — do NOT reuse the dev value:
#     openssl rand -hex 32
# The server refuses to start under NODE_ENV=production if this is empty.
SESSION_SECRET=

# How long a generated summary is served from cache (ms). Default 15 minutes.
SUMMARY_TTL_MS=900000

# ---- Auto-refresh -------------------------------------------------------
# Rebuilds every connected company on a cron. Leave false unless you want the
# server pulling from Intuit on a schedule.
AUTO_REFRESH_ENABLED=false
AUTO_REFRESH_CRON=0 6 * * 1-5
