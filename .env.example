# ---- Intuit app credentials (developer.intuit.com > your app > Keys) ----
QBO_CLIENT_ID=your_client_id
QBO_CLIENT_SECRET=your_client_secret

# sandbox | production
QBO_ENVIRONMENT=sandbox

# Must match a Redirect URI registered on your Intuit app, character for character.
QBO_REDIRECT_URI=https://192.168.1.25.nip.io:4000/quickbooks-return

# Intuit API minor version. Newer versions add fields; check the changelog before bumping.
QBO_MINOR_VERSION=75

# ---- Server ----
PORT=4000
CLIENT_ORIGIN=http://192.168.1.25.nip.io:5173
SESSION_SECRET=generate-a-long-random-string
DATA_DIR=./.data

# How long a generated summary is served from cache (ms). Default 15 minutes.
SUMMARY_TTL_MS=900000

# ---- Auto-refresh (Phase 4) ----
AUTO_REFRESH_ENABLED=false
AUTO_REFRESH_CRON=0 6 * * 1-5
